{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexSpot",
  "version": "0.3.0",
  "identifier": "com.squareuncle.nexspot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:28420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexSpot",
        "width": 960,
        "height": 620,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "opener": null,
    "shell": null,
    "notification": null,
    "single-instance": null,
    "dialog": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}