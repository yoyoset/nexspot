{
    "name": "nexspot",
    "private": true,
    "version": "0.3.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "tsc --noEmit",
        "preview": "vite preview",
        "tauri": "tauri",
        "release": "tauri build",
        "release:smoke": "node scripts/release-smoke.mjs --write-evidence docs/13-SMOKE-EVIDENCE.json",
        "release:installer:smoke": "node scripts/release-installer-smoke.mjs --execute --write-evidence docs/14-INSTALLER-SMOKE-EVIDENCE.json",
        "release:verify": "node scripts/release-verify.mjs",
        "release:evidence": "node scripts/release-verify.mjs --write-evidence docs/11-RELEASE-EVIDENCE.json",
        "qa:manual:gate": "node scripts/manual-qa-gate.mjs --write-evidence docs/17-MANUAL-QA-GATE.json",
        "qa:manual:gate:strict": "node scripts/manual-qa-gate.mjs --strict --write-evidence docs/17-MANUAL-QA-GATE.json"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.10.1",
        "@tauri-apps/plugin-dialog": "^2.6.0",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-shell": "^2.2.0",
        "clsx": "^2.1.1",
        "framer-motion": "^12.0.6",
        "i18next": "^25.8.0",
        "i18next-browser-languagedetector": "^8.2.0",
        "lucide-react": "^0.474.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^16.5.4",
        "react-markdown": "^10.1.0",
        "tailwind-merge": "^3.0.1",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "@tauri-apps/cli": "^2.10.0",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.1",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.7.3",
        "vite": "^7.3.1"
    }
}
